{
  "version": 2,
  "builds": [
    {
      "src": "*.php",
      "use": "@vercel/php@0.7.0"
    },
    {
      "src": "api/*.php",
      "use": "@vercel/php@0.7.0"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "uploads/**",
      "use": "@vercel/static"
    },
    {
      "src": "data/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*\\.html)", "dest": "/$1" },
    { "src": "/(.*\\.css)", "dest": "/$1" },
    { "src": "/(.*\\.js)", "dest": "/$1" },
    { "src": "/(.*\\.php)", "dest": "/$1" },
    { "src": "/(.*\\.json)", "dest": "/$1" },
    { "src": "/(.*\\.txt)", "dest": "/$1" },
    { "src": "/(.*\\.(png|jpg|jpeg|gif|svg|ico|webp))", "dest": "/$1" },
    { "src": "/(.*\\.(ttf|woff|woff2|eot))", "dest": "/$1" },
    { "src": "/uploads/(.*)", "dest": "/uploads/$1" },
    { "src": "/(.*)", "dest": "/$1", "continue": true },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}

