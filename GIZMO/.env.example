# cPanel / hosted MySQL credentials
# Copy this file to .env, then fill in the values from cPanel > MySQL Databases.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_gizmo
DB_USER=cpaneluser_gizmo
DB_PASS=replace_with_database_password

# TiDB Cloud only: Base64 content of the CA certificate downloaded from Connect.
DB_SSL_CA_BASE64=

# Optional AI provider key
AI_API_KEY=

# Optional Google Sign-In client ID
GOOGLE_CLIENT_ID=
